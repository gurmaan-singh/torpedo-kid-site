---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/torpedo/PageIntro.astro';
import { contact, mailto } from '~/site';

const metadata = {
  title: 'Join us',
  description: 'Help us get the Torpedo Kid driving, and then take it to Sweden.',
};

const work = [
  ['Mechanical engineering', 'Chassis, suspension, steering, brakes, drive shafts and cooling.'],
  ['Electronics', 'The battery, its management system, the CAN network and road-legal lights.'],
  ['Making and assembly', 'Turning CAD into parts, then fitting them to the car.'],
  ['Telling the story', 'Photos, posts, this website and the people who help us along the way.'],
];
---

<Layout metadata={metadata}>
  <PageIntro title="Help us build it, then drive it" lead="We are looking for students who like making things work.">
    <a class="cta gap" href={mailto('Joining TorpedoKid')}>Email us about joining</a>
  </PageIntro>

  <section class="band">
    <div class="wrap">
      <h2 class="title">Where you can help</h2>
      <dl>
        {
          work.map(([k, v]) => (
            <div class="split row">
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="band band-stone">
    <div class="wrap split">
      <h2 class="title">What to send</h2>
      <div class="copy">
        <p>Tell us what you study, what you would like to work on and how much time you have.</p>
        <p>
          Write to <a href={mailto('Joining TorpedoKid')}>{contact.email}</a> or message us on <a
            href={contact.instagram}>Instagram</a
          >.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gap {
    margin-top: 2rem;
  }
  dl {
    display: grid;
    gap: clamp(2rem, 3.5vw, 3rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  .row {
    align-items: baseline;
    gap: 0.5rem clamp(2rem, 6vw, 6rem);
  }
  dt {
    font-family: var(--font-besley), serif;
    font-size: clamp(1.375rem, 2vw, 1.75rem);
    letter-spacing: -0.015em;
    color: var(--burgundy);
  }
  dd {
    margin: 0;
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--graphite);
    max-width: 50ch;
    text-wrap: pretty;
  }
</style>
