---
import { Icon } from 'astro-icon/components';
import Mark from './Mark.astro';
import { nav } from '~/site';

const here = Astro.url.pathname.replace(/(\.html)?\/?$/, '') || '/';
const current = (href: string) => ((href.replace(/\/$/, '') || '/') === here ? 'page' : undefined);
---

<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="progress" aria-hidden="true" style="animation-timeline: scroll(root)"></div>
  <div class="wrap bar">
    <a class="brand" href={nav[0].href}><Mark /><span>TorpedoKid</span></a>
    <nav class="desktop" aria-label="Main">
      {
        nav.map((l) => (
          <a href={l.href} aria-current={current(l.href)}>
            {l.text}
          </a>
        ))
      }
    </nav>
    <details class="mobile">
      <summary aria-label="Menu">
        <Icon name="tabler:menu-2" class="open" />
        <Icon name="tabler:x" class="close" />
      </summary>
      <nav aria-label="Main">
        {
          nav.map((l) => (
            <a href={l.href} aria-current={current(l.href)}>
              {l.text}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -6rem;
    z-index: 60;
    background: var(--white);
    color: var(--charcoal);
    padding: 0.75rem 1rem;
  }
  .skip:focus {
    top: 1rem;
  }
  .site-header {
    --mark-bg: var(--charcoal);
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--charcoal);
    color: var(--cream);
  }
  /* Reading progress. Inline style carries the timeline: the CSS minifier folds animation-timeline into
     the shorthand, which browsers reject. Without scroll timelines Reveal.astro sets --read instead. */
  .progress {
    position: absolute;
    inset: 100% 0 auto;
    height: 3px;
    background: var(--burgundy);
    transform: scaleX(var(--read, 0));
    transform-origin: left;
    pointer-events: none;
  }
  @supports (animation-timeline: scroll()) {
    .progress {
      animation: read linear both;
    }
  }
  @keyframes read {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .progress {
      display: none;
    }
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    min-height: 2.75rem;
  }
  nav a {
    color: var(--light-text);
  }
  nav a:hover,
  nav a[aria-current] {
    color: var(--light-brass);
  }
  .desktop {
    display: flex;
    gap: 1.25rem;
  }
  .desktop a {
    position: relative;
    padding: 0.75rem 0.5rem;
  }
  /* Underline sweeps in from the left on hover and keyboard focus. */
  .desktop a::after {
    content: '';
    position: absolute;
    inset: auto 0.5rem 0.5rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    .desktop a::after {
      transition: transform 0.35s var(--ease);
    }
  }
  .desktop a:hover::after,
  .desktop a:focus-visible::after {
    transform: scaleX(1);
  }
  .mobile {
    display: none;
  }
  summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-right: -0.75rem;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
  }
  details[open] summary :global(.open),
  details:not([open]) summary :global(.close) {
    display: none;
  }
  .mobile nav {
    position: absolute;
    inset: 100% 0 auto;
    background: var(--charcoal);
    padding: 0.5rem var(--gutter) 2rem;
    display: grid;
  }
  .mobile nav a {
    font-size: 1.5rem;
    padding-block: 0.75rem;
  }
  @media (max-width: 47.99rem) {
    .desktop {
      display: none;
    }
    .mobile {
      display: block;
    }
  }
</style>

<script>
  // The menu is a <details>: close it on a link tap (same-page links do not reload), on Escape and on an outside tap.
  const closeMenu = () => document.querySelectorAll('details.mobile[open]').forEach((d) => d.removeAttribute('open'));
  document.addEventListener('click', (e) => {
    const t = e.target as Element;
    if (t.closest('details.mobile nav a') || !t.closest('details.mobile')) closeMenu();
  });
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeMenu());
</script>
