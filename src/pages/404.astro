---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/torpedo/PageIntro.astro';
import { getHomePermalink } from '~/utils/permalinks';
---

<Layout metadata={{ title: 'Page not found', robots: { index: false, follow: true } }}>
  <PageIntro title="This road doesn't go anywhere" lead="The page you asked for doesn't exist or has moved.">
    <a class="cta gap" href={getHomePermalink()}>Go to the homepage</a>
  </PageIntro>
</Layout>

<style>
  .gap {
    margin-top: 2rem;
  }
</style>
