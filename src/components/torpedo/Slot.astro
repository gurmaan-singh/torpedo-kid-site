---
// A photo frame. Without an image it shows a designed placeholder panel instead of a broken box.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  image?: ImageMetadata;
  alt?: string;
  ratio?: string;
  sizes?: string;
  dark?: boolean;
  file?: string;
}
const { image, alt = '', ratio = '4 / 3', sizes = '(min-width: 64rem) 30vw, 92vw', dark = false, file = 'content.ts' } = Astro.props;
---

<div class:list={['ph', 'slot', { 'slot-empty': !image, dark }]} style={`--ratio: ${ratio}`}>
  {
    image ? (
      <Image
        src={image}
        alt={alt}
        widths={[360, 540, 720, 960].filter((w) => w <= image.width)}
        sizes={sizes}
      />
    ) : (
      <span class="slot-label" role="img" aria-label="Photo to be added">
        PHOTO · add in {file}
      </span>
    )
  }
</div>

<style>
  .slot {
    aspect-ratio: var(--ratio);
    position: relative;
    background: var(--stone);
  }
  .slot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slot-empty {
    display: grid;
    place-items: center;
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(37 39 36 / 0.045) 14px 15px), var(--warm-grey);
    border: 1px solid rgb(37 39 36 / 0.12);
  }
  .slot-empty.dark {
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(243 240 232 / 0.05) 14px 15px), #33362f;
    border-color: rgb(243 240 232 / 0.14);
  }
  .slot-label {
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--graphite);
    padding: 0.4rem 0.7rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    text-align: center;
  }
  .dark .slot-label {
    color: var(--light-text);
  }
</style>
