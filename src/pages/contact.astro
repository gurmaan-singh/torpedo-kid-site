---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/torpedo/PageIntro.astro';
import { contact, mailto } from '~/site';

const metadata = {
  title: 'Contact',
  description: 'Email the TorpedoKid team, or find us on Instagram and LinkedIn.',
};

const ways = [
  { label: 'Email', text: contact.email, href: mailto() },
  { label: 'Instagram', text: '@torpedokid', href: contact.instagram },
  { label: 'LinkedIn', text: 'Fontys Engineering TorpedoKid', href: contact.linkedin },
];
---

<Layout metadata={metadata}>
  <PageIntro
    title="Get in touch"
    lead="Questions, ideas, or an old photo of the car? We would like to hear from you."
  />

  <section class="band">
    <div class="wrap">
      <h2 class="sr-only">Ways to reach us</h2>
      <dl>
        {
          ways.map((w) => (
            <div>
              <dt>{w.label}</dt>
              <dd>
                <a href={w.href}>{w.text}</a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</Layout>

<style>
  dl {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  dt {
    color: var(--burgundy);
    font-size: 1.125rem;
  }
  dd {
    margin: 0.25rem 0 0;
    font-family: var(--font-besley), serif;
    font-size: clamp(1.25rem, 3.2vw, 2.625rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--charcoal);
    overflow-wrap: anywhere;
  }
  a {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--brass);
    text-underline-offset: 0.2em;
  }
  a:hover {
    color: var(--burgundy);
  }
</style>
