---
import Layout from '~/layouts/PageLayout.astro';
import PageIntro from '~/components/torpedo/PageIntro.astro';
import Partners from '~/components/torpedo/Partners.astro';
import { contact, mailto } from '~/site';

const metadata = {
  title: 'Partners',
  description: 'The partners who make the TorpedoKid project possible, and how to become one.',
};
---

<Layout metadata={metadata}>
  <PageIntro title="Thank you to our partners" lead="They made this project possible." />

  <section class="band">
    <div class="wrap">
      <h2 class="sr-only">Our partners</h2>
      <Partners />
    </div>
  </section>

  <section class="band band-stone">
    <div class="wrap split">
      <h2 class="title">Become a partner</h2>
      <div class="copy">
        <p>
          Building a car and driving it to Sweden takes parts, tools, knowledge and funding. If your company can help
          with any of these, we would like to talk.
        </p>
        <p>
          Email <a href={mailto('Partnering with TorpedoKid')}>{contact.email}</a> and tell us what you have in mind.
        </p>
        <a class="cta" href={mailto('Partnering with TorpedoKid')}>Email us about partnering</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .copy .cta {
    margin-top: 2rem;
    color: var(--white);
    text-decoration: none;
  }
</style>
