---
import { partners } from '~/site';
---

<ul class="partners">
  {
    partners.map((p) => {
      const mark = p.logo ? (
        <img
          src={p.logo.src}
          width={p.logo.width}
          height={p.logo.height}
          alt={p.name}
          style={`--h: ${p.height ?? 3}rem`}
          loading="lazy"
        />
      ) : (
        <span class="text-mark">{p.name}</span>
      );
      return (
        <li>
          {p.href ? (
            <a href={p.href} target="_blank" rel="noopener noreferrer">
              {mark}
            </a>
          ) : (
            mark
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .partners {
    --gap: clamp(2rem, 4vw, 4rem);
    --cols: 2;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(2.5rem, 5vw, 4.5rem) var(--gap);
  }
  .partners > li {
    width: calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
  }
  @media (min-width: 48rem) {
    .partners {
      --cols: 4;
    }
  }
  li,
  li a {
    display: grid;
    place-items: center;
  }
  li a {
    padding: 0.75rem;
    min-height: 2.75rem;
  }
  /* Logos sit in grey until hovered or focused; touch screens always show colour. */
  @media (hover: hover) {
    img {
      filter: grayscale(1);
      opacity: 0.75;
    }
    @media (prefers-reduced-motion: no-preference) {
      img {
        transition:
          filter 0.4s,
          opacity 0.4s;
      }
    }
    a:hover img,
    a:focus-visible img {
      filter: none;
      opacity: 1;
    }
  }
  img {
    height: auto;
    max-height: var(--h);
    width: auto;
    max-width: 100%;
  }
  .text-mark {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 600;
    color: var(--charcoal);
  }
</style>
