---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-besley` / `--font-familjen`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: var(--font-familjen);
    --aw-font-serif: var(--font-besley);
    --aw-font-heading: var(--font-besley);

        /* Brand colors */
    --aw-color-primary: rgb(165 138 92);
    --aw-color-secondary: rgb(140 56 48);
    --aw-color-accent: rgb(140 56 48);

    --aw-color-text-heading: rgb(37 39 36);
    --aw-color-text-default: rgb(49 50 46);
    --aw-color-text-muted: rgb(49 50 46 / 65%);
    --aw-color-bg-page: rgb(243 240 232);

    --aw-color-bg-page-dark: rgb(37 39 36);

    ::selection {
      background-color: rgb(165 138 92);
      color: rgb(255 255 255);
    }
  }

  .dark {
    --aw-font-sans: var(--font-familjen);
    --aw-font-serif: var(--font-besley);
    --aw-font-heading: var(--font-besley);

    /* Brand colors */
    --aw-color-primary: rgb(197 169 121);
    --aw-color-secondary: rgb(165 93 78);
    --aw-color-accent: rgb(165 93 78);

    --aw-color-text-heading: rgb(243 240 232);
    --aw-color-text-default: rgb(224 220 210);
    --aw-color-text-muted: rgb(224 220 210 / 65%);
    --aw-color-bg-page: rgb(37 39 36);


    ::selection {
      background-color: rgb(165 138 92);
      color: rgb(37 39 36);
    }
  }
</style>
