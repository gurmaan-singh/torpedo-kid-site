---
// Adds the `js` class that lets torpedo.css hide things before they are revealed. The motion itself
// lives in src/scripts/motion.ts. Without script (or with reduced motion) nothing stays hidden.
---

<script is:inline data-astro-rerun>
  // Runs in <head>, before first paint. ClientRouter swaps <html> attributes, so re-add after a swap.
  document.documentElement.classList.add('js');
  document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
</script>

<script>
  import '~/scripts/motion';
</script>
