---
// "What we are building": the CAD render with the spec list as callouts. On desktop motion.ts pins
// the stage and draws one leader line per scroll step; elsewhere it is a plain image plus list.
// Spec text comes from car.ts, unchanged. Every plain number in a value is wrapped so it can count up.
import { Image } from 'astro:assets';
import cad from '~/assets/images/torpedo/car/cad-assembly.jpg';
import { specs } from '~/car';

// Stage is 1600 x 900 units. The render sits centred at full height: x = 264 + 1.3235 px, y = 1.3235 py.
const X = (px: number) => Math.round(264 + px * 1.3235);
const Y = (py: number) => Math.round(py * 1.3235);
// Where each callout points on the render (image pixels), which side its label sits on and its height.
const anchors: { pt: [number, number]; side: 'l' | 'r'; y: number }[] = [
  { pt: [345, 130], side: 'l', y: 150 }, // Seats: the driver
  { pt: [560, 95], side: 'r', y: 130 }, // Motor: rear frame
  { pt: [470, 335], side: 'r', y: 470 }, // Battery: under the driver
  { pt: [505, 520], side: 'r', y: 690 }, // Range
  { pt: [735, 160], side: 'r', y: 300 }, // Top speed
  { pt: [235, 400], side: 'l', y: 540 }, // Weight: the frame
  { pt: [125, 545], side: 'l', y: 740 }, // Suspension: front wishbones
  { pt: [300, 330], side: 'l', y: 345 }, // Vehicle class: roll cage
];
const html = (v: string) => v.replace(/(?<![\w.])(\d+(?:\.\d+)?)(?!\w)/g, '<span class="num" data-to="$1">$1</span>');
const items = specs.map(([k, v], i) => {
  const a = anchors[i];
  const sx = a.side === 'l' ? 256 : 1344;
  const px = X(a.pt[0]);
  const py = Y(a.pt[1]);
  const mid = a.side === 'l' ? sx + 70 : sx - 70;
  return { k, v: html(v), a, px, py, d: `M${px} ${py} L${mid} ${a.y} L${sx} ${a.y}` };
});
---

<div class="build-stage" data-build>
  <div class="stage">
    <Image
      src={cad}
      alt="CAD model of our car without its body: a tube frame in three sections, four wheels and a seated driver."
      widths={[480, 640, 810]}
      sizes="(min-width: 64rem) 50vw, 92vw"
      class="cad-img"
    />
    <svg class="lines" viewBox="0 0 1600 900" aria-hidden="true">
      {
        items.map((it) => (
          <g class="lead">
            <path d={it.d} pathLength="100" />
            <circle cx={it.px} cy={it.py} r="7" />
          </g>
        ))
      }
    </svg>
    <dl class="callouts">
      {
        items.map((it) => (
          <div class="callout" data-side={it.a.side} style={`--y: ${(it.a.y / 9).toFixed(2)}%`}>
            <dt>{it.k}</dt>
            <dd set:html={it.v} />
          </div>
        ))
      }
    </dl>
  </div>
</div>

<style>
  .stage {
    position: relative;
    width: 100%;
  }
  .cad-img {
    display: block;
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .lines {
    display: none;
  }
  .callouts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    gap: 1.5rem 2rem;
    margin-top: 2rem;
  }
  dt {
    color: var(--burgundy);
  }
  dd {
    color: var(--charcoal);
    font-size: 1.25rem;
    line-height: 1.3;
    margin: 0.15rem 0 0;
  }

  @media (min-width: 64rem) {
    .build-stage {
      width: min(100%, calc((100svh - 19rem) * 16 / 9));
      margin-inline: auto;
    }
    .stage {
      aspect-ratio: 16 / 9;
    }
    .cad-img {
      position: absolute;
      left: 16.5%;
      top: 0;
      width: 67%;
      height: 100%;
      object-fit: contain;
    }
    .lines {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }
    .lead path {
      fill: none;
      stroke: var(--burgundy);
      stroke-width: 2.5;
      stroke-dasharray: 100 100;
      stroke-dashoffset: 0;
    }
    .lead circle {
      fill: var(--burgundy);
      stroke: var(--cream);
      stroke-width: 3;
    }
    .callouts {
      display: block;
      margin: 0;
    }
    .callout {
      position: absolute;
      top: var(--y);
      width: 15%;
      transform: translateY(-50%);
    }
    .callout[data-side='l'] {
      left: 0;
      text-align: right;
    }
    .callout[data-side='r'] {
      left: 85%;
    }
    dd {
      font-family: var(--font-besley), serif;
      font-size: clamp(1rem, 1.55vw, 1.5rem);
    }
    dt {
      font-size: 0.9rem;
    }
  }
</style>
