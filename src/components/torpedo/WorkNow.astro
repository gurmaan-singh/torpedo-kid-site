---
import { Image } from 'astro:assets';
import { workNow } from '~/car';
---

<div class="rows">
  {
    workNow.map((w) => (
      <article class:list={['row', { 'no-image': !w.image }]}>
        <div>
          <h3>{w.name}</h3>
          <p>{w.text}</p>
        </div>
        {w.image && (
          <Image
            src={w.image}
            alt={w.alt ?? ''}
            widths={[360, 480, w.image.width].filter((x, i, a) => x <= w.image.width && a.indexOf(x) === i)}
            sizes="(min-width: 56rem) 40vw, 92vw"
            class:list={{ cad: w.cad }}
          />
        )}
      </article>
    ))
  }
</div>

<style>
  .rows {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem) clamp(2rem, 5vw, 5rem);
  }
  h3 {
    font-family: var(--font-besley), serif;
    font-size: clamp(1.5rem, 2.2vw, 2rem);
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--burgundy);
  }
  p {
    margin-top: 0.75rem;
    color: var(--graphite);
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .row {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .row img {
    width: 100%;
    height: auto;
  }
  .row img:not(.cad) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  /* CAD renders have a white background; multiply lets the page show through. */
  .cad {
    mix-blend-mode: multiply;
    max-height: 22rem;
    object-fit: contain;
  }
  @media (min-width: 56rem) {
    .rows {
      grid-template-columns: 1fr 1fr;
    }
    .row:not(.no-image) {
      grid-template-rows: subgrid;
      grid-row: span 2;
    }
  }
</style>
